{
    "manifest_version": 3,
    "name": "TaskPilot Companion",
    "version": "1.2",
    "description": "Enables TaskPilot AI to interact with browser tabs. Works with Chrome, Edge, and all Chromium browsers.",
    "permissions": [
        "activeTab",
        "scripting",
        "tabs",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "overlay.css"
            ],
            "run_at": "document_end"
        }
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "externally_connectable": {
        "matches": [
            "http://localhost:5173/*",
            "http://localhost:3000/*",
            "http://localhost:3001/*",
            "http://127.0.0.1:5173/*",
            "http://127.0.0.1:3000/*",
            "http://127.0.0.1:3001/*"
        ]
    },
    "web_accessible_resources": [
        {
            "resources": [
                "overlay.css"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}